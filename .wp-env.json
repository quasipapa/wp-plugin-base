{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.3",
	"mappings": {
		"wp-content/plugins/{{SLUG}}": "."
	},
	"lifecycleScripts": {
		"afterStart": "npx wp-env run cli wp plugin activate {{SLUG}}"
	},
	"port": 8888,
	"testsEnvironment": false,
	"config": {
		"WP_DEBUG": true,
		"SCRIPT_DEBUG": true
	}
}
